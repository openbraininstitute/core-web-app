*[_type=="swipeableList"][0]
{
  title,
  "button": buttonLabel,
  "link": internalLink->slug.current,
  "list": mediumItemList[] {
    title,
    subtitle,
    "text": paragraph,
    "imageURL": image.asset->url,
    "imageWidth": image.asset->metadata.dimensions.width,
    "imageHeight": image.asset->metadata.dimensions.height
  }
}
