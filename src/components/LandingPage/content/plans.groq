{
  "plans": *[_type=="plan"] | order(position) {
    "id": _id,
    "title": title,
    "notes": notes,
    "price": {
      "month": monthlyPlanNormal[] {
        "value": price,
        "currency": currency
      },
      "discount": monthlyPlanDiscount[] {
        "value": price,
        "currency": currency
      }, 
      "yearNormal": yearlyPlanNormal[] {
        "value": price,
        "currency": currency
      },
      "yearDiscount": yearlyPlanDiscount[] {
        "value": price,
        "currency": currency
      }
    },
    "features": *[_type=="featureBlocList"].featuresBloc[] {
      "title": title,
      "available": isAvailable,
      "featuresList": features[count(linkedPlan[plan->_id == ^._id]) > 0] {
        "title": title,
        "specialLabel": linkedPlan[plan->_id == ^._id].specialLabel,
        "tooltip": linkedPlan[plan->_id == ^._id].tooltip
      }
    }
  }
}