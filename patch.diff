-function filterAndEnrichTree<T extends ICircuit>(
-  nodes: HierarchyNode[],
-  filteredIds: Set<string>,
-  fullById: Record<string, T>
-): HierarchyOutputNode[] {
-  return nodes
-    .map((node) => {
