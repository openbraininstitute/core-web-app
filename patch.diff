diff --git a/src/ui/segments/sfn-2025/landing-page.module.css b/src/ui/segments/sfn-2025/landing-page.module.css
new file mode 100644
index 000000000..053b3a497
--- /dev/null
+++ b/src/ui/segments/sfn-2025/landing-page.module.css
@@ -0,0 +1,153 @@
+@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=Gabarito:wght@400..900&display=swap');
+
+.landingPage {
+  --color-background: #fff;
+  --color-on-bakground: #000;
+  --color-neutral: var(--Colors-Gray-4, #bfbfbf);
+  --color-neutral-light: var(--Colors-Gray-4, #f0f0f0);
+  --color-on-neutral: var(--color-on-bakground);
+  --color-primary: var(--Colors-Blue-8, #003a8c);
+  --color-primary-light: var(--Colors-Blue-8, #1897e6);
+  --color-on-primary: var(--color-background);
+  --font-serif: 'DM Serif Text', serif;
+  --font-sans-serif: 'Gabarito', sans-serif;
+  --font-size-M: 19px;
+  --font-size-S: calc(0.8 * var(--font-size-M));
+  --font-size-M-plus: calc(1.2 * var(--font-size-M));
+  --font-size-L: calc(1.5 * var(--font-size-M));
+  --font-size-XL: calc(2 * var(--font-size-M));
+  --gap-XL: 64px;
+  --gap-L: 32px;
+  --gap-M: 16px;
+  --gap-S: 8px;
+  --gap-XS: 4px;
+
+  text-rendering: optimizeLegibility;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+
+  width: 100%;
+  max-width: 100vw;
+  margin: 0;
+  padding: 0;
+  color: var(--color-primary);
+  background-color: var(--color-background);
+  font-family: 'Gabarito', serif;
+  font-optical-sizing: auto;
+  font-weight: normal;
+  font-style: normal;
+  text-wrap: auto;
+  font-size: var(--font-size-M);
+  scroll-behavior: smooth;
+}
+
+.landingPage a,
+.landingPage button {
+  cursor: pointer;
+  font-size: var(--font-size-M);
+  box-sizing: border-box;
+}
+
+.landingPage :global(.font-gabarito) {
+  font-family: var(--font-sans-serif);
+  font-optical-sizing: auto;
+  font-weight: normal;
+  font-style: normal;
+}
+
+.landingPage :global(.font-dm) {
+  font-family: var(--font-serif);
+  font-weight: 400;
+  font-style: normal;
+}
+
+.landingPage :global(.font-dm-italic) {
+  font-family: var(--font-serif);
+  font-weight: 400;
+  font-style: italic;
+}
+
+.landingPage h1 {
+  font-size: var(--font-size-XL);
+  margin: 0.4em 0;
+  box-sizing: content-box;
+  line-height: 1.3;
+}
+
+.landingPage h1::after {
+  content: '';
+  display: none;
+  position: absolute;
+  left: 0;
+  top: 50%;
+  width: calc(var(--margin) - 0.5em);
+  height: 2px;
+  background-color: var(--color-background, #000);
+}
+
+.landingPage h1 > big {
+  display: block;
+  font-weight: bolder;
+  margin: 0;
+}
+
+.landingPage h2 {
+  font-size: var(--font-size-L);
+  line-height: 1.3;
+}
+
+.landingPage h3 {
+  font-size: var(--font-size-M);
+}
+
+.landingPage h4 {
+  font-size: 22px;
+  text-transform: uppercase;
+  letter-spacing: 0.02em;
+  margin-top: 20px;
+
+  &::after {
+    content: '';
+    display: block;
+    width: 32px;
+    height: 1px;
+    background: var(--Colors-Gray-4, #bfbfbf);
+    margin: 20px 0;
+  }
+}
+
+.landingPage h1,
+.landingPage h2,
+.landingPage h3 {
+  text-wrap: balance;
+  position: relative;
+  font-family: var(--font-serif);
+}
+
+.landingPage p {
+  font-size: var(--font-size-M);
+  text-wrap: auto;
+  hyphens: none;
+  word-spacing: 0;
+  line-height: 1.55;
+}
+
+@media (max-width: 640px) {
+  .landingPage {
+    --font-size-M: 16px;
+  }
+  .landingPage h1:after {
+    display: none;
+  }
+}
+
+@media (max-width: 480px) {
+  .landingPage {
+    --font-size-M: 14px;
+  }
+}
+
+.landingPage big {
+  font-weight: bold;
+  font-size: 110%;
+}
