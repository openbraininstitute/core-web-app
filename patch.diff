-  const picked = pick(viewDefinitions, categoryAvailableTypesKeys);
-
-  const tabs = map(picked, (item, key) => {
-    return {
-      key: getEntityByExtendedType({ type: key as TExtendedEntitiesTypeDict })?.slug,
-      label: item!.title,
-      name: item!.name,
-    };
