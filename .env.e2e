# E2E Test Environment Variables
# Copy this file or load it before running E2E tests.
# Fill in the values for your target environment.

# Virtual Lab Manager API base URL
VIRTUAL_LAB_API_URL=

# Keycloak OAuth configuration
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Test user credentials for Keycloak authentication
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=

# Application base URL (defaults to http://localhost:3000 if not set)
NEXTAUTH_URL=http://localhost:3000
